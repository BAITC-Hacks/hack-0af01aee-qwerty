{
  "name": "studyai", "private": true, "version": "1.0.0", "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env server-dist/server/index.js",
    "test": "tsx --test server/tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8", "dotenv": "^17.2.3", "express": "^5.1.0",
    "lucide-react": "^0.468.0", "openai": "^6.0.0", "react": "^19.2.0", "react-dom": "^19.2.0", "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0", "@tailwindcss/vite": "^4.1.0", "@types/express": "^5.0.0", "@types/node": "^24.0.0",
    "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0", "tailwindcss": "^4.1.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "vite": "^7.1.0"
  }
}
